# DOCUMENTATION (exclude large generated files)
# ================================================================
*.pdf
# Exception: Keep small documentation PDFs
!02_documentation/**/*.pdf

# ================================================================
# SPECIFIC PROJECT EXCLUSIONS
# ================================================================
# Archive folders (old code)
07_archived/archive/
07_archived/backups/
07_archived/google_drive_backup/

# Legacy utilities
04_utilities/utilities_legacy/
04_utilities/utils_legacy/

# Test samples (can be large)
05_webapp/ms_detector_webapp/test_samples/*.nii.gz
05_webapp/ms_detector_webapp/test_samples/*.nii

# ================================================================
# KEEP IMPORTANT FILES (exceptions to above rules)
# ================================================================
# Keep small example models for testing
!**/example_model_small.pth
!**/demo_checkpoint.pt

# Keep documentation
!README.md
!LICENSE
!**/*.md

# Keep configuration files
!requirements.txt
!**/package.json
!**/*.yaml
!**/*.yml
!**/*.json

# Keep source code
!**/*.py
!**/*.js
!**/*.jsx
!**/*.ts
!**/*.tsx
!**/*.html
!**/*.css

