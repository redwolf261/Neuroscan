# Environment Configuration for Backend

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False

# Model Configuration
MODEL_PATH=./models/model_deployable.pth

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Upload Configuration
MAX_CONTENT_LENGTH=524288000  # 500MB in bytes
UPLOAD_FOLDER=./uploads

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost

# Device Configuration (auto, cuda, cpu)
DEVICE=auto
